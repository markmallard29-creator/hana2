# ---- Required for real research + writing ----
# Leave either blank to run in demo mode with sample articles.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=

# Models (optional). The "smart" model ranks articles and writes the email
# copy; the "fast" model writes the per-article summaries.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# ---- Required for real sending ----
# Leave blank to run sends in demo mode (nothing is emailed).
RESEND_API_KEY=
# Must be on a domain you have verified in Resend.
EMAIL_FROM="HANA <newsletter@hana.news>"
EMAIL_REPLY_TO=
# Pre-fills the "Send a test to" box on the send step.
TEST_EMAIL=mark@mathison.ai

# ---- Database ----
# Local dev: a file. Production (Vercel): a Turso database URL + token.
DATABASE_URL=file:./data/hana.db
DATABASE_AUTH_TOKEN=

# ---- App ----
# Public URL, used for unsubscribe and "view in browser" links.
APP_URL=http://localhost:3000
# Password for the app. Leave blank to disable login (local dev only).
APP_PASSWORD=
# Postal address shown in the email footer (required by UK PECR / US CAN-SPAM).
SENDER_ADDRESS="Mathison AI, Bristol, UK"
