# ---- Required for real research + writing ----
# Leave either blank to run in demo mode with sample articles.
TAVILY_API_KEY=
# Or Exa (better at features and long reads). If both are set, SEARCH_PROVIDER=exa picks Exa.
EXA_API_KEY=
SEARCH_PROVIDER=
ANTHROPIC_API_KEY=

# Or use OpenAI instead of Claude: set OPENAI_API_KEY (and leave ANTHROPIC_API_KEY
# blank, or set LLM_PROVIDER=openai). Models are optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_FAST_MODEL=gpt-6-luna
LLM_PROVIDER=

# Claude models (optional). The "smart" model ranks articles and writes the email
# copy; the "fast" model writes the per-article summaries.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# ---- Required for real sending ----
# Leave blank to run sends in demo mode (nothing is emailed).
RESEND_API_KEY=
# Must be on a domain you have verified in Resend.
EMAIL_FROM="HANA <newsletter@hana.news>"
EMAIL_REPLY_TO=
# Pre-fills the "Send a test to" box on the send step.
TEST_EMAIL=mark@mathison.ai

# ---- Database ----
# Local dev: a file. Production (Vercel): a Turso database URL + token.
DATABASE_URL=file:./data/hana.db
DATABASE_AUTH_TOKEN=

# ---- App ----
# Public URL, used for unsubscribe and "view in browser" links.
APP_URL=http://localhost:3000
# Password for the app. Leave blank to disable login (local dev only).
APP_PASSWORD=
# Postal address shown in the email footer (required by UK PECR / US CAN-SPAM).
SENDER_ADDRESS="Mathison AI, Bristol, UK"

# ---- Cost meter (optional) ----
# Prices are built in for Claude Sonnet/Haiku 5.5, GPT-6 Luna and Tavily pay-as-you-go.
# Add or override model prices (USD per million input, output tokens):
MODEL_PRICES=
# e.g. MODEL_PRICES={"gpt-6.2-sol":[1.25,10]}
# Tavily credit price if you're on a monthly plan (default 0.008):
TAVILY_CREDIT_USD=
# Resend is plan-priced; set a per-email figure if you want it in the meter:
RESEND_EMAIL_USD=

# ---- Schedules (optional) ----
# HANA checks for due schedules every minute by itself. To also allow an external cron
# to trigger runs (POST /api/cron, "Authorization: Bearer <secret>"), set a long secret:
CRON_SECRET=
# DISABLE_SCHEDULER=1 turns the built-in timer off.
DISABLE_SCHEDULER=
